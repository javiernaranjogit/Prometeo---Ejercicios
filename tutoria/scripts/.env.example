# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore y NUNCA debe subirse al repositorio.

# Tu correo institucional
IMAP_USER=javier.naranjo@thepower.education

# Contraseña de aplicación de 16 caracteres (NO tu contraseña normal).
# Se genera en: https://myaccount.google.com/apppasswords
# Requiere tener la verificación en dos pasos activada.
# Pégala sin espacios.
IMAP_PASS=xxxxxxxxxxxxxxxx

# Servidor IMAP (para Google Workspace no hace falta cambiarlo)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
